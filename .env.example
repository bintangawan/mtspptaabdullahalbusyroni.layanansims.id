APP_NAME="PPTA Abdullah Al Busyroni"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mtspptaabdullahalbusyroni.layanansims.id
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mtsppta_db
DB_USERNAME=root
DB_PASSWORD=bintang0951

# Menggunakan database lebih stabil di VPS dibanding file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Cache ke database agar I/O disk VPS tidak bengkak
CACHE_STORE=database
CACHE_PREFIX=mts_ppta_

# Queue ke database (Wajib setup worker nanti)
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# --- EMAIL CONFIG (GMAIL SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sharingbang00@gmail.com
MAIL_PASSWORD=isi_16_digit_app_password_disini
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sharingbang00@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# --- ASSET COMPILATION ---
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# --- GEMINI API (PRODUCTION) ---
# Pastikan ambil key asli di https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_Ganti_Dengan_Key_Asli
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.8
GEMINI_TOP_K=40